<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="8dp"
            android:text="ActiveAppTime"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="16dp"
            android:text="Показывает время за сегодня для текущего приложения в чипе рядом с часами (Android Live Updates)."
            android:textSize="15sp" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="20dp"
            android:textSize="16sp" />

        <Button
            android:id="@+id/usageButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="1. Разрешить доступ к использованию" />

        <Button
            android:id="@+id/notifButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="2. Разрешить уведомления" />

        <Button
            android:id="@+id/liveButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="3. Настройки Live Updates (чип)" />

        <Button
            android:id="@+id/batteryButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="4. Отключить оптимизацию батареи" />

        <Button
            android:id="@+id/toggleButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Запустить мониторинг" />

    </LinearLayout>
</ScrollView>
